<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
<!--RESOURCE_LOCAL potem zamienic na JTA-->
    <persistence-unit name="SklepPU" transaction-type="RESOURCE_LOCAL">
        <class>org.example.projektjavaee.model.Product</class>
        <class>org.example.projektjavaee.model.User</class>
        <class>org.example.projektjavaee.model.Role</class>
        <class>org.example.projektjavaee.model.Order</class>
        <class>org.example.projektjavaee.model.OrderItem</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:sklepdb;DB_CLOSE_DELAY=-1"/>
            <property name="jakarta.persistence.jdbc.user" value="marcin"/>
            <property name="jakarta.persistence.jdbc.password" value="marcin"/>

            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>

            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
            <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="jakarta.persistence.logging.level" value="FINE"/>
        </properties>
    </persistence-unit>
</persistence>
